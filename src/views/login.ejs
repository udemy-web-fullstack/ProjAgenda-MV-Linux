<%- include('includes/head') %>
  <%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8 my-3">
      <h1 class="text-center">Criar conta ou Entrar</h1>
      <p class="text-center lead">Cadastre-se ou faça login abaixo.</p>

      <%- include('includes/messages') %>

      <div class="row">

        <div class="col-lg my-5">
          <h4>Faça seu cadastro</h4>

          <p>Crie sua conta, preencha nosso formulário:</p>

          <form class="form-cadastro" action="/login/register" method="POST">
            <input type="hidden" name="_csrf" value=<%=csrfToken %>>
            <div class="mb-3">
              <label>Seu e-mail</label>
              <input type="email" class="form-control" name="email">
            </div>
            <div class="mb-3">
              <label>Sua senha</label>
              <input type="password" class="form-control" name="password">
            </div>
            <button type="submit" class="btn btn-primary">Criando Conta</button>
          </form>

        </div>

        <div class="col-lg my-5">
          <h4>Efetue seu login</h4>

          <p>Caso possua uma conta, realize login:</p>

          <form class="form-login" action="/login/login" method="POST">
            <input type="hidden" name="_csrf" value=<%=csrfToken %>>
            <div class="mb-3">
              <label>Seu e-mail</label>
              <input type="email" class="form-control" name="email">
            </div>
            <div class="mb-3">
              <label>Sua senha</label>
              <input type="password" class="form-control" name="password">
            </div>
            <button type="submit" class="btn btn-primary">Acessar Conta</button>
          </form>
        </div>

      </div>

    </div>

    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('includes/footer') %>